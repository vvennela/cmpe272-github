{
  "profile": "product-admin",
  "sourceRoots": [
    "backend/templates",
    "backend/static/dashboard.js",
    "backend/static/dashboard.css",
    "backend/static/account.js"
  ],
  "locale": "en-US",
  "canonicalMap": "DESIGN.md",
  "requiredCapabilities": [
    "Form",
    "Scrollbar"
  ],
  "ownership": {
    "Form": "backend/templates/dashboard.html and backend/static/dashboard.js",
    "Scrollbar": "backend/static/dashboard.css"
  },
  "requiredCommands": [
    "unit",
    "javascript",
    "ui"
  ],
  "commands": {
    "unit": "python -m unittest discover -s tests -v",
    "javascript": "node --check backend/static/dashboard.js && node --check backend/static/account.js",
    "ui": "npm run test:ui"
  }
}
