# Server credential for Routes API and Places API (New). Set in .env.local.
GOOGLE_MAPS_API_KEY=

# Optional public browser key for the directions map only. Use a separate key
# restricted to Maps JavaScript API and your localhost/production HTTP referrers.
# Never reuse GOOGLE_MAPS_API_KEY here.
GOOGLE_MAPS_BROWSER_API_KEY=

# Required for accounts. Generate a private value in .env.local, not in Git.
SESSION_SECRET=
# Set true when serving production over HTTPS.
SESSION_COOKIE_SECURE=false
# Local rate limits are in memory; use shared storage for multiple workers.
RATELIMIT_STORAGE_URI=memory://
